<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Secrets are encrypted with a Keystore key that isn't backed up or transferred, so a copy
         couldn't be read. Movie posters are fetched again when they're missing. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="tangible_secrets.xml" />
        <exclude domain="file" path="posters/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tangible_secrets.xml" />
        <exclude domain="file" path="posters/" />
    </device-transfer>
</data-extraction-rules>
