<?xml version="1.0" encoding="utf-8"?>
<!-- Backups on Android 11 and older (Android 12+ uses data_extraction_rules.xml). -->
<full-backup-content>
    <!-- Encrypted with a Keystore key that isn't backed up, so a restored copy couldn't be read. -->
    <exclude domain="sharedpref" path="tangible_secrets.xml" />
    <!-- Movie posters are fetched again when they're missing. -->
    <exclude domain="file" path="posters/" />
</full-backup-content>
